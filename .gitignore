# 安装包、运行时和构建输出只保留在本地或 GitHub Release，不提交源码仓库。
dist/
release/
release-*/
runtime/
runtime-node/
runtime-plugins/
node_modules/

# 开发过程产物仅保留在本地。
coverage/
*.log

runtime-dsh/
runtime-dsh.tgz
runtime-dsh.tgz.sha256
.codegraph/
_tmp*

# 便携版部署目录：只保留脚本和说明，应用、用户数据、工具链及工作区不提交。
App/
Data/
Tools/
Workspace/*
!Workspace/README.md
Customize/App-Overlay/*
!Customize/App-Overlay/.gitkeep

# 用户工作区（中文名）不提交。
开发空间/
工作空间/

# 本地工作产物与无关目录（2026-09-09 基线清理，不入库；2026-09-18 修复编码损坏并补会话目录）。
.tmp/
.stability-dist/
.workbuddy/
