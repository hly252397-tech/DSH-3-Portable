{
  "name": "deepseek-harness-desktop",
  "version": "1.0.67",
  "description": "DeepSeek Harness native desktop launcher",
  "author": "MichengAI",
  "desktopName": "DSH Codex Desktop",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": "24.21.0",
    "pnpm": "11.26.0"
  },
  "config": {
    "bundledNodeVersion": "v24.21.0",
    "bundledNodeSha256": {
      "win32-x64": "BA4E6D110E8C1592A1ECD390F6B05F3DA124B13871A5BE62B341A07A853C6C32",
      "darwin-arm64": "E4B5A3AF0E05C75DE2EAE013904145F40FE7FC2A6E6F17510128BF45CCA4E79B",
      "darwin-x64": "7ABCF39BD37AB251015337FF75304D7555F0D8E88C6E0FBF04BCE8CE34636F49",
      "linux-arm64": "0F8949D1028F6D61506B2D5BC57E7E6FE893D7B1997509B7847294FC9C616584",
      "linux-x64": "7FDE7B8AFA198DA66257F42EE2001D874C7355631E6D1579A5FB5EF1F246DF4C"
    },
    "bundledDshVersion": "0.1.6-alpha.1"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "spec:check": "node scripts/verify-dsh-official-baseline.mjs --online",
    "spec:check:local": "node scripts/verify-dsh-official-baseline.mjs",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "pnpm run build && node scripts/run-tests.mjs",
    "start": "pnpm run build && electron .",
    "prepare-runtime": "pnpm run build && node dist/scripts/prepare-runtime.js",
    "pack": "pnpm run prepare-runtime && electron-builder --dir --publish never",
    "dist": "pnpm run prepare-runtime && electron-builder --publish never",
    "smoke:mac": "pnpm run build && node dist/scripts/smoke-macos-package.mjs",
    "smoke:linux": "pnpm run build && node dist/scripts/smoke-linux-package.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "3.1.1",
    "@types/node": "26.5.1",
    "electron": "44.3.0",
    "electron-builder": "26.16.1",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "ai.micheng.deepseekHarnessDesktop",
    "productName": "DSH Codex Desktop",
    "icon": "assets/icon.png",
    "asar": true,
    "afterPack": "dist/scripts/adhoc-sign.mjs",
    "afterSign": "dist/scripts/notarize.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "browser-library.cjs"
    ],
    "extraResources": [
      {
        "from": "dist/release-source.json",
        "to": "release-source.json"
      },
      {
        "from": "runtime-node",
        "to": "node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/src/dsh-bootstrap.mjs",
        "to": "bootstrap.mjs"
      },
      {
        "from": "dist/src/extract-runtime.js",
        "to": "extract-runtime.mjs"
      },
      {
        "from": "dist/src/runtime-archive.js",
        "to": "runtime-archive.js"
      },
      {
        "from": "dist/src/process-control.js",
        "to": "process-control.js"
      },
      {
        "from": "runtime-plugins/store.tgz",
        "to": "plugins-store.tgz"
      },
      {
        "from": "runtime-plugins/store.tgz.sha256",
        "to": "plugins-store.tgz.sha256"
      },
      {
        "from": "runtime-plugins/store.tgz.content-sha256",
        "to": "plugins-store.tgz.content-sha256"
      },
      {
        "from": "runtime-dsh.tgz",
        "to": "dsh-runtime.tgz"
      },
      {
        "from": "runtime-dsh.tgz.sha256",
        "to": "dsh-runtime.tgz.sha256"
      },
      {
        "from": "runtime-dsh.tgz.content-sha256",
        "to": "dsh-runtime.tgz.content-sha256"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/icons/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "assets/icons/taskbar.png",
        "to": "taskbar.png"
      },
      {
        "from": "assets/icons/taskbar-optical.ico",
        "to": "taskbar-optical.ico"
      },
      {
        "from": "assets/icons/notification.ico",
        "to": "notification.ico"
      },
      {
        "from": "assets/startup.html",
        "to": "startup.html"
      },
      {
        "from": "assets/whale-particles.js",
        "to": "whale-particles.js"
      },
      {
        "from": "assets/shell.html",
        "to": "shell.html"
      },
      {
        "from": "assets/browser-panel.html",
        "to": "browser-panel.html"
      },
      {
        "from": "assets/browser-workspace.css",
        "to": "browser-workspace.css"
      },
      {
        "from": "assets/browser-workspace.js",
        "to": "browser-workspace.js"
      },
      {
        "from": "assets/theme.js",
        "to": "theme.js"
      },
      {
        "from": "assets/theme.css",
        "to": "theme.css"
      },
      {
        "from": "assets/shortcuts.html",
        "to": "shortcuts.html"
      },
      {
        "from": "assets/feature-panels.html",
        "to": "feature-panels.html"
      },
      {
        "from": "assets/about.html",
        "to": "about.html"
      },
      {
        "from": "assets/settings.html",
        "to": "settings.html"
      },
      {
        "from": "assets/task-badges",
        "to": "task-badges",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/shell-icons",
        "to": "shell-icons",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist/src",
        "to": "desktop-bridge",
        "filter": [
          "desktop-bridge.mjs",
          "desktop-bridge-client-source.js",
          "desktop-host.js",
          "atomic-file.js",
          "bundled-plugins.js",
          "dsh-process.js",
          "plugin-seed.js",
          "plugin-toolchain.js",
          "profile-bundle-health.js",
          "profile-quarantine.js",
          "profile-updates.js",
          "process-control.js",
          "readiness.js",
          "runtime-archive.js",
          "runtime-prebuilt.js",
          "startup-progress.js"
        ]
      }
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "extraFiles": [
        {
          "from": "assets/icons/icon.ico",
          "to": "DSH Codex Desktop.ico"
        }
      ],
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "dsh-codex-desktop-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "assets/icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "dsh-codex-desktop-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "executableName": "dsh-codex-desktop",
      "maintainer": "MichengAI <coolyujiyu@qq.com>",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "dsh-codex-desktop-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "installerHeaderIcon": "assets/icons/icon.ico",
      "include": "build/installer.nsh",
      "shortcutName": "DSH Codex Desktop",
      "uninstallDisplayName": "DSH Codex Desktop"
    },
    "executableName": "DSH Codex Desktop",
    "publish": {
      "provider": "github",
      "owner": "MichengAI",
      "repo": "dsh-codex-desktop",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MichengAI/dsh-codex-desktop.git"
  }
}
